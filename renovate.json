{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:biomeVersions",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions",
    ":semanticCommitTypeAll(build)"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": "every 4 week on Monday"
  },
  "pyenv": {
    "enabled": false
  },
  "rangeStrategy": "update-lockfile",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Lower-bound pins are adjusted manually when the declared lower bounds change",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "matchJsonata": ["$contains(managerData.depGroup, /^compat(-.+)?-lowest$/)"],
      "enabled": false
    },
    {
      "matchCategories": ["python"],
      "addLabels": ["python"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"]
    },
    {
      "description": "Read the Biome schema version from GitHub tags, like the mise tool",
      "matchManagers": ["custom.jsonata"],
      "matchPackageNames": ["@biomejs/biome"],
      "overrideDatasource": "github-tags",
      "overridePackageName": "biomejs/biome"
    },
    {
      "description": "Extract Biome versions from tags and update the tool and schema together",
      "matchPackageNames": ["biomejs/biome"],
      "extractVersion": "^@biomejs/biome@(?<version>.+)$",
      "groupName": "biome"
    }
  ]
}
